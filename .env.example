# Optional only: webhook remains disabled until this is set in the server process.
# This file is documentation; the application does not auto-load .env files.
TRADING_WEBHOOK_TOKEN=
# Optional state location; defaults to /workspace/trading/.local in this checkout.
TRADING_DATA_DIR=
# Optional explicit hostname for a protected reverse proxy (no scheme or port).
TRADING_ALLOWED_HOSTS=
# Optional desktop GitHub API token for a private repository or higher API limit.
# Never paste tokens into the UI, commit .env, or include them in a distribution.
TRADING_GITHUB_TOKEN=
