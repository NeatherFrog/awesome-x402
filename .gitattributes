# Public research snapshots and license fingerprints require identical bytes.
* text=auto eol=lf
# Preserve upstream snapshot bytes, including any deliberate CRLF originals.
data/** -text
*.zip -text
*.png -text
propdesk/tzdata/Europe/* -text
propdesk/tzdata/America/* -text
propdesk/tzdata/Asia/* -text
propdesk/tzdata/Etc/* -text
propdesk/tzdata/UTC -text

# These optional historical reports remain in Git and full local builds.
# Omit them from source archives so installed 0.5 packages can fetch the first
# upgrade within their original 50 MiB extracted-archive limit.
docs/edge-search.json export-ignore
docs/current-research.json export-ignore
# Updates never manage data. Portable public locks are in docs/research-receipts;
# installed user data and bundled fixtures remain in place. Full Git checkouts
# retain the original research artifacts and the builder's fixture sources.
/data export-ignore
